{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/marketplace/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Manrope|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Manrope, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|appearance|dot|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, appearance, dot, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|voltage|pulse|gold|success|warning|danger|verified)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'voltage' | 'pulse' | 'gold' | 'success' | 'warning' | 'danger' | 'verified'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:solid|soft|outline)$/]",
        "message": "<Badge> appearance must be one of 'solid' | 'soft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|full|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, full, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|gold)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|label|count|icon|height|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: image, label, count, icon, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='EquipmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|category|supplier|price|unit|availability|rating|location|verified|key|ref|className|style|children)$/]",
        "message": "<EquipmentCard> doesn't accept that prop. Declared props: image, title, category, supplier, price, unit, availability, rating, location, verified."
      },
      {
        "selector": "JSXOpeningElement[name.name='EquipmentCard'] > JSXAttribute[name.name='availability'] > Literal[value!=/^(?:available|limited|booked)$/]",
        "message": "<EquipmentCard> availability must be one of 'available' | 'limited' | 'booked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='RentalDurationSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|presets|style|key|ref|className|style|children)$/]",
        "message": "<RentalDurationSelector> doesn't accept that prop. Declared props: value, onChange, presets, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|buttonLabel|onSearch|size|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: placeholder, buttonLabel, onSearch, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<SearchBar> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|desc|meta|dark|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: icon, title, desc, meta, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|desc|icon|tag|key|ref|className|style|children)$/]",
        "message": "<ServiceOption> doesn't accept that prop. Declared props: id, label, desc, icon, tag."
      },
      {
        "selector": "JSXOpeningElement[name.name='SupplierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|name|specialty|rating|reviews|location|verified|listings|key|ref|className|style|children)$/]",
        "message": "<SupplierCard> doesn't accept that prop. Declared props: logo, name, specialty, rating, reviews, location, verified, listings."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
